# Copy to `.env` for local development. Never commit a real `.env`.
# Cloud platforms (Fly, Render) read these names from their secrets manager.

# ---- LLM ------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
ANSWER_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# ---- Vector + sparse stores ----------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
ELASTIC_URL=http://localhost:9200

# ---- Optional metadata store (currently used only by the prod compose) ---
POSTGRES_HOST=postgres
POSTGRES_DB=opsassist
POSTGRES_USER=opsassist
POSTGRES_PASSWORD=opsassist

# ---- Application knobs ---------------------------------------------------
ANSWER_PROMPT=concise        # concise | with_citations | chain_of_thought | no_citations
ENABLE_FEEDBACK=true
DISABLE_TELEMETRY=true
PORT=8501

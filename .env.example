OPENAI_API_KEY=sk-...

# Persistent vector store; do NOT set to anything in-memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=opsassist

# Embedding model dimensions are fixed per model; only change EMBED_DIM if
# you switch models (and pick a fresh QDRANT_COLLECTION to avoid mismatches).
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Chunking parameters (tokens)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
